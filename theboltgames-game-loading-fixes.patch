+/* Shared player layout: keep the game usable below a wrapping mobile toolbar. */
+body { height: 100vh; height: 100dvh; }
+.top-bar { flex: 0 0 auto; flex-wrap: wrap; gap: 0.6rem; }
+.player-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-left: auto; }
+.back-btn { display: inline-block; }
+.back-btn:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
+[hidden] { display: none !important; }
+#player-status { flex: 0 0 auto; color: #cdbbdf; padding: 0.5rem 1rem; font-size: 0.8rem; line-height: 1.4; }
+#game-frame { display: block; flex: 1 1 0; min-height: 0; width: 100%; }
+#game-frame:fullscreen { height: 100%; background: #000; }
+@media (max-width: 640px) {
+  .top-bar { padding: 0.6rem; }
+  .player-actions { margin-left: 0; width: 100%; }
+  .back-btn { padding: 0.4rem 0.8rem; }
+}
diff --git a/player.js b/player.js
new file mode 100644
index 0000000..b22bee4
--- /dev/null
+++ b/player.js
@@ -0,0 +1,30 @@
+(() => {
+  const frame = document.getElementById('game-frame');
+  const status = document.getElementById('player-status');
+  const retry = document.getElementById('retry-game');
+  const fullscreen = document.getElementById('fullscreen-game');
+  const hint = 'Click inside the game to play. If it stays blank, try Retry or Open game.';
+
+  // Cross-origin frames can fire load even for error pages. Never report that
+  // a game is playable based on this event, or hide the recovery controls.
+  frame.addEventListener('load', () => { status.textContent = hint; });
+  frame.addEventListener('error', () => {
+    status.textContent = 'The game could not be loaded. Try Retry or Open game.';
+  });
+  retry.hidden = false;
+  retry.addEventListener('click', () => {
+    status.textContent = 'Reloading the game. If it stays blank, try Open game.';
+    frame.src = frame.getAttribute('src');
+  });
+  if (document.fullscreenEnabled && frame.requestFullscreen) {
+    fullscreen.hidden = false;
+    fullscreen.addEventListener('click', async () => {
+      try {
+        await frame.requestFullscreen();
+        frame.focus();
+      } catch {
+        status.textContent = 'Fullscreen is unavailable. You can use Open game instead.';
+      }
+    });
+  }
+})();
